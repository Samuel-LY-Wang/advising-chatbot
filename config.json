{
    "recursive_depth": 2,
    "ignore_domains": ["mailto:", "tel:", "youtube.com", "youtu.be", "twitter.com", "facebook.com", "linkedin.com", "arxiv.org", ".pptx"],
    "embed_model": "bge-m3",
    "rerank_model": "BAAI/bge-reranker-v2-m3",
    "chat_model": "qwen3.5:4b",
    "chunk_size": 300,
    "chunk_overlap": 100,
    "chunks_to_retrieve": 40,
    "chunks_to_keep": 5,
    "raw_data_path": "data/raw",
    "chunk_path": "data/chunks",
    "db_path": "data/chroma_db",
    "mappings_path": "data/mappings",
    "doc_mapping_file": "link_file_mapping.json",
    "chunk_mapping_file": "chunk_file_mapping.json",
    "HTTP_fetch_error_file": "data/HTTP_fetch_errors.txt",
    "sources":  [
    "https://content.cs.umass.edu/content/fall-2026-course-description",
    "https://content.cs.umass.edu/content/spring-2026-course-descriptions",
    "https://www.cics.umass.edu/academics/courses/prerequisite-catalog-and-credit-changes"],
    "header": {
        "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36"
    }
}